#!/bin/bash
# pi-sudo: run a command with sudo, using the password saved by the Security app.
# Use it in your own apps/scripts in place of "sudo", e.g.  pi-sudo mdadm --detail /dev/md0
if sudo -n true 2>/dev/null; then exec sudo "$@"; fi
PW="$(secret-tool lookup service pi-security user "$USER" 2>/dev/null)"
if [ -n "$PW" ]; then
  printf '%s\n' "$PW" | sudo -S -p '' "$@"
else
  exec sudo "$@"
fi
